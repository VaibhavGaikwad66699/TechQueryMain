# TechQuery Environment Configuration (Copy to .env for local use)

# Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for local auth (generate any random string)
SECRET_KEY=techquery-super-secret-local-jwt-key-change-in-production-32bytes

# Database URL (SQLite is used for local zero-configuration development)
DATABASE_URL=sqlite:///./data/techquery.db

# Storage Directory for uploaded PDFs
DOCUMENTS_DIR=./data/documents
MAX_PDF_BYTES=52428800
MAX_INGESTION_JOBS=1

# PDF reading runs in bounded child processes; page checkpoints survive restarts.
# Optional full path; otherwise pdftotext is detected, with a pypdf fallback.
PDFTOTEXT_PATH=
PDF_EXTRACT_BATCH_PAGES=25
PDF_EXTRACT_TIMEOUT_SECONDS=60
PDF_MAX_PAGES=3000
PDF_MAX_BATCH_OUTPUT_BYTES=16777216
PDF_MAX_TEXT_BYTES=67108864

# Gemini Models
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
INDEX_MAX_CHUNKS_PER_REQUEST=16
EMBEDDING_MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_MS=10000
GENERATION_TIMEOUT_MS=30000
GENERATION_MAX_ATTEMPTS=2
ALLOW_GENERAL_ANSWERS=true
RETRIEVAL_MIN_SIMILARITY=0.65

# Backend Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed browser origins (JSON array; set actual HTTPS origins for deployment)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
