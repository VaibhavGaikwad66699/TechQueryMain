# Copy through prepare_production.py; this template deliberately cannot boot production.
ENVIRONMENT=production
PUBLIC_ORIGIN=https://replace-with-your-domain.invalid
SITE_ADDRESS=replace-with-your-domain.invalid
BACKEND_CORS_ORIGINS=["https://replace-with-your-domain.invalid"]
TRUSTED_HOSTS=["replace-with-your-domain.invalid","localhost","127.0.0.1"]
SERVE_FRONTEND=true
FRONTEND_DIST=/app/frontend/dist
DATABASE_URL=sqlite:////data/live/techquery.db
DOCUMENTS_DIR=/data/live/documents
SECRET_KEY_FILE=/run/secrets/jwt_secret
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
MAX_PDF_BYTES=52428800
MAX_INGESTION_JOBS=1
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
INDEX_MAX_CHUNKS_PER_REQUEST=16
